# Local PostgreSQL password. Set a unique, non-empty value in .env.
POSTGRES_PASSWORD=replace-with-a-strong-local-password
# Non-secret database connection settings for the local FYPHub container.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55732
POSTGRES_DB=fyphub_p1
POSTGRES_USER=fyphub_p1_user
# Registration eligibility mode. Keep restricted in production; use demo only for a temporary panel presentation.
REGISTRATION_MODE=restricted
# Password recovery delivery. Keep APP_ENV=development for local-only reset-link retrieval.
APP_ENV=development
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_PROPOSAL_MODEL=llama3.1:8b
OLLAMA_AGENT_MODEL=llama3.1:8b
AI_TIMEOUT_SECONDS=8
AI_MAX_RETRIES=1
AI_RATE_LIMIT_PER_MINUTE=10
DOCUMENT_STORAGE_ROOT=backend/storage/document-requirements
